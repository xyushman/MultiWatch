{
  "name": "multiwatch",
  "private": true,
  "version": "2.0.0",
  "description": "Multi-stream viewer for YouTube, Twitch, and Kick",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "serve": "node server/index.js",
    "start": "node server/index.js",
    "wall": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-multiwatch.ps1",
    "wall:preview": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-multiwatch.ps1 -Url http://localhost:4173"
  },
  "dependencies": {
    "pinia": "^3.0.4",
    "vue": "^3.5.25",
    "vuedraggable": "^4.1.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.2",
    "vite": "^7.3.1"
  }
}
